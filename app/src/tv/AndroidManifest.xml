<?xml version="1.0" encoding="utf-8"?>
<!-- TV 渠道 Manifest：与主 Manifest 合并，只做电视必需的补充 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 电视无触摸屏 / 无摄像头 / 无定位，声明为非必需，避免被过滤 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vibrate"
        android:required="false" />

    <application
        android:name="com.sister.habits.tv.TvApp"
        android:banner="@drawable/tv_banner"
        tools:replace="android:name">

        <!-- 电视上不再申请相机（扫码用不到） -->
        <uses-permission
            android:name="android.permission.CAMERA"
            tools:node="remove" />

        <!-- 看片：选片（Hub 代理） -->
        <activity
            android:name="com.sister.habits.tv.TvVideoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- 看片：播放页 -->
        <activity
            android:name="com.sister.habits.tv.TvPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- 主入口：追加 LEANBACK_LAUNCHER，让遥控器主页能出现；强制横屏 -->
        <activity
            android:name="com.sister.habits.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.sister.habits.child.ChildActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:screenOrientation="landscape" />

        <activity
            android:name="com.sister.habits.parent.ParentActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:screenOrientation="landscape" />
    </application>
</manifest>