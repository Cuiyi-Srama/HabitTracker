<?xml version="1.0" encoding="utf-8"?>
<!-- TV 渠道覆盖版「孩子模式」首页：字号放大 + 新增「看电视」入口，id 与原版保持一致 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_child">
    <!-- 顶部：每日一句 -->
    <TextView
        android:id="@+id/tv_daily_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#FFF3E0"
        android:text="🌟 加载中..."
        android:textSize="18sp"
        android:textColor="#E65100"
        android:lineSpacingExtra="3dp"
        android:gravity="center" />
    <!-- 顶部：金币余额 + 打卡按钮 + 设置 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/child_pink_light">
        <TextView
            android:id="@+id/tv_coin_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="🪙 0"
            android:textSize="34sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">
            <!-- TV 新增：看电视入口 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tv_watch"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:backgroundTint="#1F6FEB"
                android:focusable="true"
                android:text="📺 看电视"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                app:cornerRadius="28dp" />
            <TextView
                android:id="@+id/btn_child_settings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="设置"
                android:focusable="true"
                android:gravity="center"
                android:text="⚙️"
                android:textSize="26sp" />
            <TextView
                android:id="@+id/btn_submit_homework"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="提交作业"
                android:focusable="true"
                android:gravity="center"
                android:text="📝"
                android:textSize="26sp" />
            <TextView
                android:id="@+id/btn_laundry"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="洗衣任务"
                android:focusable="true"
                android:gravity="center"
                android:text="🧺"
                android:textSize="26sp" />
            <TextView
                android:id="@+id/btn_lottery"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="抽奖"
                android:focusable="true"
                android:gravity="center"
                android:text="🎰"
                android:textSize="26sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_check_in"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:backgroundTint="@color/child_green"
                android:focusable="true"
                android:text="📅 打卡"
                android:textAllCaps="false"
                android:textSize="22sp"
                app:cornerRadius="32dp" />
        </LinearLayout>
    </RelativeLayout>
    <!-- 积分预期 -->
    <TextView
        android:id="@+id/tv_earning_estimate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:background="#FFF8E1"
        android:text="📈 预计今日: 0分 | 待审批: 0 | 上限: 60"
        android:textColor="#FF666666"
        android:textSize="17sp" />
    <!-- 🎯 愿望进度条（攒分目标） -->
    <LinearLayout
        android:id="@+id/ll_wish_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:background="#E8F5E9"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"></LinearLayout>
    <!-- 底部导航 TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@android:color/white"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextAppearance="@android:style/TextAppearance.Large" />
    <!-- ViewPager2 内容区 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>