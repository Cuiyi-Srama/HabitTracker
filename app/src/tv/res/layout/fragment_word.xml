<?xml version="1.0" encoding="utf-8"?>
<!-- TV 渠道专属背单词布局（覆盖 src/main 同名）
     所有元素标记 android:tag="tv_compat_skip"，防 TvCompat 二次放大字号撑爆布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:orientation="horizontal"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:background="@drawable/card_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_word_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:tag="tv_compat_skip"
            android:text="📖 加载中..."
            android:textColor="#666666"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:tag="tv_compat_skip"
            android:text="🔥 "
            android:textColor="#FF6B35"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_word_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:tag="tv_compat_skip"
            android:text="apple"
            android:textColor="#333333"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_phonetic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:tag="tv_compat_skip"
            android:text="/ˈæp.əl/"
            android:textColor="#999999"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:tag="tv_compat_skip"
            android:text="选出正确的中文意思"
            android:textColor="#666666"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_speak"
            android:layout_width="88dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="朗读"
            android:focusable="true"
            android:gravity="center"
            android:tag="tv_compat_skip"
            android:text="🔊"
            android:textSize="40sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_option_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@id/btn_option_2"
            android:tag="tv_compat_skip"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btn_option_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@id/btn_option_3"
            android:nextFocusUp="@id/btn_option_1"
            android:tag="tv_compat_skip"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btn_option_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@id/btn_option_4"
            android:nextFocusUp="@id/btn_option_2"
            android:tag="tv_compat_skip"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btn_option_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@id/btn_new_words"
            android:nextFocusUp="@id/btn_option_3"
            android:tag="tv_compat_skip"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btn_dont_know"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#FFF3E0"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:minHeight="56dp"
            android:nextFocusDown="@id/btn_new_words"
            android:nextFocusUp="@id/btn_option_4"
            android:tag="tv_compat_skip"
            android:text="😅 我不会"
            android:textAllCaps="false"
            android:textColor="#E65100"
            android:textSize="20sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_new_words"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="56dp"
                android:nextFocusRight="@id/btn_review"
                android:nextFocusUp="@id/btn_dont_know"
                android:tag="tv_compat_skip"
                android:text="📚 新词"
                android:textAllCaps="false"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_review"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="56dp"
                android:nextFocusLeft="@id/btn_new_words"
                android:nextFocusUp="@id/btn_dont_know"
                android:tag="tv_compat_skip"
                android:text="🔄 复习"
                android:textAllCaps="false"
                android:textSize="20sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
