<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HabitTracker" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/child_pink</item>
        <item name="colorPrimaryVariant">@color/child_pink_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/child_green</item>
        <item name="android:statusBarColor">@color/child_pink_light</item>
    </style>

    <style name="Theme.HabitTracker.Child" parent="Theme.HabitTracker">
        <item name="colorPrimary">@color/child_pink</item>
        <item name="android:statusBarColor">@color/child_pink_light</item>
    </style>

    <style name="Theme.HabitTracker.Parent" parent="Theme.HabitTracker">
        <item name="colorPrimary">@color/parent_blue</item>
        <item name="android:statusBarColor">@color/background_parent</item>
    </style>
</resources>