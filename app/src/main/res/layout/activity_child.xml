<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_child">

    <!-- 顶部：每日一句 -->
    <TextView
        android:id="@+id/tv_daily_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFF3E0"
        android:text="🌟 加载中..."
        android:textSize="13sp"
        android:textColor="#E65100"
        android:lineSpacingExtra="2dp"
        android:gravity="center" />

    <!-- 顶部：金币余额 + 打卡按钮 + 设置 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/child_pink_light">

        <TextView
            android:id="@+id/tv_coin_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="🪙 0"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_child_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="⚙️"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="设置" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_check_in"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="📅 打卡"
                android:textSize="16sp"
                android:textAllCaps="false"
                app:cornerRadius="24dp"
                android:backgroundTint="@color/child_green" />

        </LinearLayout>

    </RelativeLayout>
    <!-- 积分预期 -->
    <TextView
        android:id="@+id/tv_earning_estimate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="📈 预计今日: 0分 | 待审批: 0 | 上限: 60"
        android:textSize="12sp"
        android:textColor="#FF666666"
        android:background="#FFF8E1" />

    <!-- 底部导航 TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:color/white"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- ViewPager2 内容区 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>